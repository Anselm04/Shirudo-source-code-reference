[Unit]
Description=shirudo: periodically synchronize the signed BPM upatch tree

[Timer]
OnBootSec=60s
OnUnitActiveSec=60s
Persistent=true
AccuracySec=1s
Unit=shirudo-bpm-tree-sync.service

[Install]
WantedBy=timers.target
